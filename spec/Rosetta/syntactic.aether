Rosetta(start):
    (
        (IndexEntry {Newline IndexEntry})@index /
        (MappingEntry {Newline MappingEntry})@mapping
    ) [Newline]
    ;

IndexEntry:
    FileMode Comma FilePath Comma FileHash
    ;

MappingEntry:
    (AnonymousTextRange@text / AnonymousBinaryRange@binary) Comma Range
    ;

Range:
    ZeroBasedInteger Comma (AnonymousTextRange | AnonymousBinaryRange)
    ;

AnonymousTextRange:
    OneBasedInteger Comma OneBasedInteger Comma OneBasedInteger Comma OneBasedInteger
    ;

AnonymousBinaryRange:
    ZeroBasedInteger Comma ZeroBasedInteger
    ;
