Comma: , ;

Newline: \r? \n ;

FileMode@index: [bt] ;

FilePath@index: ([^\n\r,\\] | \\ [,\\nr])+ ;

FileHash@index: [0-9a-f]{64} ;

ZeroBasedInteger@mapping: 0 | [1-9] [0-9]* ;

OneBasedInteger@mapping: [1-9] [0-9]* ;
